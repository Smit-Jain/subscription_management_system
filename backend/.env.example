# Server
PORT=5000
NODE_ENV=development

# Database (Docker default — change for hosted DB)
DATABASE_URL="postgresql://brightloop:brightloop_secret@localhost:5432/brightloop_dev?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Password reset / invite token TTLs
RESET_TOKEN_TTL_MINUTES=30
INVITE_TOKEN_TTL_HOURS=24

# bcrypt cost factor
BCRYPT_ROUNDS=10

# SMTP (leave blank in dev — reset links print to console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop <no-reply@brightloop.io>"

# Seed credentials (used by db:seed)
SEED_ADMIN_EMAIL=admin@brightloop.com
SEED_ADMIN_PASSWORD=Admin@12345
